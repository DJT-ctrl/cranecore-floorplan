GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL_NORMAL=gemini-2.5-flash
GEMINI_MODEL_ENHANCED=gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK=gemini-2.5-pro
GEMINI_IMAGE_MODEL_NORMAL=gemini-2.5-flash-image
GEMINI_IMAGE_MODEL_ENHANCED=gemini-3.1-flash-image-preview
CORS_ORIGIN=http://localhost:5173

# API auth: comma-separated allowlist of accepted x-api-key values.
# Leave empty to disable key auth (rate limit will key on client IP instead).
API_KEYS=local-dev-key-change-me,another-made-up-key

# Rate limiting (per API key, or per IP if API_KEYS is empty).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MINUTES=60